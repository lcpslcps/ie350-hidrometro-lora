 {
  "id": "0134dabb779486cd",
  "type": "template",
  "z": "381530092b274a64",
  "name": "Página HTML",
  "field": "payload",
  "fieldType": "msg",
  "format": "html",
  "syntax": "plain",
  "template": "<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Hidrômetro LoRa · Monitor do enlace</title>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js\"></script>\n<style>\n  :root { --bg:#0f1720; --card:#17212c; --borda:#243241; --txt:#e6edf3; --sub:#8b9bb0;\n          --ul:#3fa7ff; --dl:#f2a541; --ok:#2ecc71; --warn:#f1c40f; --bad:#e74c3c; }\n  * { box-sizing:border-box; }\n  body { margin:0; font-family:Segoe UI, Roboto, Arial, sans-serif; background:var(--bg); color:var(--txt); }\n  header { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px;\n           padding:16px 24px; border-bottom:1px solid var(--borda); }\n  h1 { font-size:20px; margin:0; font-weight:600; }\n  h1 small { display:block; font-size:12px; color:var(--sub); font-weight:400; margin-top:2px; }\n  .chips { display:flex; gap:8px; flex-wrap:wrap; }\n  .chip { background:var(--card); border:1px solid var(--borda); border-radius:14px; padding:4px 10px; font-size:12px; color:var(--sub); }\n  .chip b { color:var(--txt); }\n  .status { display:flex; align-items:center; gap:8px; font-size:13px; }\n  .dot { width:10px; height:10px; border-radius:50%; background:var(--bad); }\n  .dot.on { background:var(--ok); box-shadow:0 0 8px var(--ok); }\n  main { padding:20px 24px; display:grid; gap:16px; }\n  .kpis { display:grid; grid-template-columns:repeat(auto-fit, minmax(150px, 1fr)); gap:12px; }\n  .kpi { background:var(--card); border:1px solid var(--borda); border-radius:10px; padding:14px; }\n  .kpi .rot { font-size:12px; color:var(--sub); }\n  .kpi .val { font-size:28px; font-weight:600; margin-top:4px; }\n  .kpi .un { font-size:13px; color:var(--sub); font-weight:400; }\n  .kpi .barra { height:6px; background:var(--borda); border-radius:3px; margin-top:10px; overflow:hidden; }\n  .kpi .barra i { display:block; height:100%; width:0; border-radius:3px; transition:width .4s; }\n  .ul { color:var(--ul); } .dl { color:var(--dl); }\n  .graficos { display:grid; grid-template-columns:2fr 1fr; gap:16px; }\n  .card { background:var(--card); border:1px solid var(--borda); border-radius:10px; padding:14px; }\n  .card h2 { font-size:14px; margin:0 0 10px; font-weight:600; color:var(--sub); }\n  .alto { height:260px; }\n  table { width:100%; border-collapse:collapse; font-size:13px; }\n  th, td { padding:6px 8px; text-align:right; border-bottom:1px solid var(--borda); }\n  th { color:var(--sub); font-weight:500; } th:first-child, td:first-child { text-align:left; }\n  button { background:transparent; color:var(--sub); border:1px solid var(--borda); border-radius:6px; padding:6px 12px; cursor:pointer; }\n  button:hover { color:var(--txt); border-color:var(--sub); }\n  @media (max-width:900px) { .graficos { grid-template-columns:1fr; } }\n</style>\n</head>\n<body>\n<header>\n  <h1>Hidrômetro LoRa · Monitor do enlace\n    <small>IE350 · Lucas Chiomark Pereira Santos · RA 195111 · tópico mot_lora_195111</small></h1>\n  <div class=\"chips\" id=\"chips\">\n    <span class=\"chip\">SF <b id=\"c-sf\">–</b></span>\n    <span class=\"chip\">BW <b id=\"c-bw\">–</b> kHz</span>\n    <span class=\"chip\">CR <b id=\"c-cr\">–</b></span>\n    <span class=\"chip\">Pot <b id=\"c-pot\">–</b> dBm</span>\n  </div>\n  <div class=\"status\"><span class=\"dot\" id=\"dot\"></span><span id=\"st\">Conectando…</span>\n    <button id=\"limpar\">Limpar</button></div>\n</header>\n\n<main>\n  <section class=\"kpis\">\n    <div class=\"kpi\"><div class=\"rot\">Medida</div><div class=\"val\"><span id=\"k-med\">–</span> <span class=\"un\">/ <span id=\"k-tot\">–</span></span></div>\n      <div class=\"barra\"><i id=\"b-med\" style=\"background:var(--sub)\"></i></div></div>\n    <div class=\"kpi\"><div class=\"rot\">PSR (taxa de sucesso)</div><div class=\"val\" id=\"k-psr\">–</div>\n      <div class=\"barra\"><i id=\"b-psr\"></i></div></div>\n    <div class=\"kpi\"><div class=\"rot ul\">RSSI subida (UL)</div><div class=\"val\"><span id=\"k-rul\">–</span> <span class=\"un\">dBm</span></div></div>\n    <div class=\"kpi\"><div class=\"rot dl\">RSSI descida (DL)</div><div class=\"val\"><span id=\"k-rdl\">–</span> <span class=\"un\">dBm</span></div></div>\n    <div class=\"kpi\"><div class=\"rot ul\">SNR subida</div><div class=\"val\"><span id=\"k-sul\">–</span> <span class=\"un\">dB</span></div></div>\n    <div class=\"kpi\"><div class=\"rot dl\">SNR descida</div><div class=\"val\"><span id=\"k-sdl\">–</span> <span class=\"un\">dB</span></div></div>\n    <div class=\"kpi\"><div class=\"rot\">Margem do enlace</div><div class=\"val\"><span id=\"k-mar\">–</span> <span class=\"un\">dB</span></div>\n      <div class=\"barra\"><i id=\"b-mar\"></i></div></div>\n    <div class=\"kpi\"><div class=\"rot\">σ RSSI UL (rodada)</div><div class=\"val\"><span id=\"k-sig\">–</span> <span class=\"un\">dB</span></div></div>\n  </section>\n\n  <section class=\"graficos\">\n    <div class=\"card\"><h2>RSSI por medida (dBm)</h2><div class=\"alto\"><canvas id=\"g-rssi\"></canvas></div></div>\n    <div class=\"card\"><h2>SNR por medida (dB)</h2><div class=\"alto\"><canvas id=\"g-snr\"></canvas></div></div>\n  </section>\n\n  <section class=\"card\">\n    <h2>Últimos pacotes</h2>\n    <table><thead><tr><th>Hora</th><th>Medida</th><th>RSSI UL</th><th>SNR UL</th><th>RSSI DL</th><th>SNR DL</th><th>PSR</th></tr></thead>\n      <tbody id=\"tab\"></tbody></table>\n  </section>\n</main>\n\n<script>\n// ---------- Gráficos ----------\nChart.defaults.color = \"#8b9bb0\";\nChart.defaults.borderColor = \"#243241\";\nconst opcoes = { responsive:true, maintainAspectRatio:false, animation:false,\n  plugins:{ legend:{ labels:{ boxWidth:12 } } },\n  scales:{ x:{ title:{ display:true, text:\"medida\" } } } };\nconst serie = (rotulo, cor) => ({ label:rotulo, data:[], borderColor:cor, backgroundColor:cor,\n                                  tension:.25, pointRadius:2, borderWidth:2 });\nconst gRssi = new Chart(document.getElementById(\"g-rssi\"), { type:\"line\", options:opcoes,\n  data:{ labels:[], datasets:[ serie(\"UL\", \"#3fa7ff\"), serie(\"DL\", \"#f2a541\") ] } });\nconst gSnr = new Chart(document.getElementById(\"g-snr\"), { type:\"line\", options:opcoes,\n  data:{ labels:[], datasets:[ serie(\"UL\", \"#3fa7ff\"), serie(\"DL\", \"#f2a541\") ] } });\n\n// ---------- Estado da rodada ----------\nlet rssiUl = [];\nconst $ = id => document.getElementById(id);\nconst fmt = (v, d = 1) => (v === null || v === undefined) ? \"–\" : Number(v).toFixed(d);\nconst cor = (v, bom, ruim) => v >= bom ? \"var(--ok)\" : v >= ruim ? \"var(--warn)\" : \"var(--bad)\";\n\nfunction desvio(a) {\n  if (a.length < 2) return null;\n  const m = a.reduce((s, x) => s + x, 0) / a.length;\n  return Math.sqrt(a.reduce((s, x) => s + (x - m) ** 2, 0) / (a.length - 1));\n}\n\nfunction limpar() {\n  rssiUl = [];\n  for (const g of [gRssi, gSnr]) { g.data.labels = []; g.data.datasets.forEach(d => d.data = []); g.update(); }\n  $(\"tab\").innerHTML = \"\";\n  [\"k-psr\",\"k-rul\",\"k-rdl\",\"k-sul\",\"k-sdl\",\"k-mar\",\"k-sig\"].forEach(id => $(id).textContent = \"–\");\n}\n$(\"limpar\").onclick = limpar;\n\nfunction trataDL(p) {\n  $(\"c-sf\").textContent = p.sf; $(\"c-bw\").textContent = p.bw;\n  $(\"c-cr\").textContent = \"4/\" + p.cr; $(\"c-pot\").textContent = p.pot;\n  if (p.nova_rodada) limpar();\n  if (p.medida >= 1) {\n    $(\"k-med\").textContent = p.medida; $(\"k-tot\").textContent = p.total;\n    $(\"b-med\").style.width = (100 * p.medida / Math.max(p.total, 1)) + \"%\";\n  }\n}\n\nfunction trataUL(p) {\n  if (!p.valido) return;   // respostas de teste de enlace / configuração\n  rssiUl.push(p.rssi_ul);\n\n  $(\"k-rul\").textContent = fmt(p.rssi_ul); $(\"k-rdl\").textContent = fmt(p.rssi_dl);\n  $(\"k-sul\").textContent = fmt(p.snr_ul, 2); $(\"k-sdl\").textContent = fmt(p.snr_dl, 2);\n  $(\"k-mar\").textContent = fmt(p.margem); $(\"k-sig\").textContent = fmt(desvio(rssiUl), 2);\n  $(\"b-mar\").style.width = Math.min(100, Math.max(0, p.margem)) + \"%\";\n  $(\"b-mar\").style.background = cor(p.margem, 20, 10);\n  if (p.psr !== null) {\n    $(\"k-psr\").textContent = fmt(p.psr) + \" %\";\n    $(\"k-psr\").style.color = cor(p.psr, 95, 80);\n    $(\"b-psr\").style.width = p.psr + \"%\"; $(\"b-psr\").style.background = cor(p.psr, 95, 80);\n  }\n\n  gRssi.data.labels.push(p.medida); gSnr.data.labels.push(p.medida);\n  gRssi.data.datasets[0].data.push(p.rssi_ul); gRssi.data.datasets[1].data.push(p.rssi_dl);\n  gSnr.data.datasets[0].data.push(p.snr_ul); gSnr.data.datasets[1].data.push(p.snr_dl);\n  gRssi.update(); gSnr.update();\n\n  const hora = new Date(p.t).toLocaleTimeString(\"pt-BR\");\n  const tr = document.createElement(\"tr\");\n  tr.innerHTML = `<td>${hora}</td><td>${p.medida}</td><td class=\"ul\">${fmt(p.rssi_ul)}</td><td class=\"ul\">${fmt(p.snr_ul,2)}</td>` +\n                 `<td class=\"dl\">${fmt(p.rssi_dl)}</td><td class=\"dl\">${fmt(p.snr_dl,2)}</td><td>${fmt(p.psr)} %</td>`;\n  $(\"tab\").prepend(tr);\n  while ($(\"tab\").children.length > 15) $(\"tab\").lastChild.remove();\n}\n\n// ---------- WebSocket do Node-RED ----------\nfunction conecta() {\n  const ws = new WebSocket((location.protocol === \"https:\" ? \"wss://\" : \"ws://\") + location.host + \"/ws/lora\");\n  ws.onopen  = () => { $(\"dot\").classList.add(\"on\"); $(\"st\").textContent = \"Conectado ao Node-RED\"; };\n  ws.onclose = () => { $(\"dot\").classList.remove(\"on\"); $(\"st\").textContent = \"Reconectando…\"; setTimeout(conecta, 2000); };\n  ws.onmessage = ev => {\n    const p = JSON.parse(ev.data);\n    if (p.tipo === \"dl\") trataDL(p); else if (p.tipo === \"ul\") trataUL(p);\n  };\n}\nconecta();\n</script>\n</body>\n</html>\n",
  "output": "str",
  "x": 330,
  "y": 320,
  "wires": [
