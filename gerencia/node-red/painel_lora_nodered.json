 {
  "id": "e8036c6783bdc65a",
  "type": "function",
  "z": "381530092b274a64",
  "name": "Decodifica DL",
  "func": "// Decodifica o pacote de DESCIDA (DL) publicado pelo Python N2/N3.\n// Bytes: 0 = SF, 1 = código da BW, 2 = CR, 3 = potência,\n//        4-5 = total de medidas da rodada, 12-13 = número da medida.\nconst b = msg.payload;\nif (!Buffer.isBuffer(b) || b.length < 20) return null;\n\nconst BW = { 1: 125, 2: 250, 3: 500 };\nconst medida = b[12] * 256 + b[13];\nconst total  = b[4] * 256 + b[5];\n\n// Medida 1 marca o início de uma rodada nova: zera os contadores\nif (medida === 1) {\n    flow.set(\"ul_count\", 0);\n    flow.set(\"dl_count\", 0);\n}\n// Pacotes com medida 0 são de teste de enlace / configuração: não contam\nif (medida >= 1) flow.set(\"dl_count\", (flow.get(\"dl_count\") || 0) + 1);\n\nflow.set(\"dl_medida\", medida);\nflow.set(\"dl_total\", total);\n\nmsg.payload = {\n    tipo: \"dl\",\n    t: Date.now(),\n    sf: b[0], bw: BW[b[1]] || b[1], cr: b[2], pot: b[3],\n    medida, total,\n    nova_rodada: medida === 1\n};\nreturn msg;\n",
  "outputs": 1,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 390,
  "y": 100,
  "wires": [
   [
    "2b29f00c7731e0c3"
   ]
  ]
 },
 {
  "id": "9fcb306b3786d827",
  "type": "function",
  "z": "381530092b274a64",
  "name": "Decodifica UL",
  "func": "// Decodifica o pacote de SUBIDA (UL) publicado pelo gateway.\n// Bytes: 0 = RSSI DL, 1 = SNR DL (medidos no nó),\n//        2 = RSSI UL, 3 = SNR UL (medidos no gateway), 7 = estado da rodada.\n// Conversões iguais às do N5: RSSI = byte/2 - 74 (byte > 128: subtrai 256), SNR = byte/4 - 30\nconst b = msg.payload;\nif (!Buffer.isBuffer(b) || b.length < 20) return null;\n\nconst rssi = v => (v > 128 ? v - 256 : v) / 2 - 74;\nconst snr  = v => v / 4 - 30;\nconst SENSIBILIDADE_SF12 = -137;   // dBm, SX1276 com BW 125 kHz\n\n// Estado 6 = medida em andamento, 5 = última medida da rodada\nconst estado = b[7];\nconst valido = estado === 5 || estado === 6;\n\nlet recebidos = flow.get(\"ul_count\") || 0;\nif (valido) {\n    recebidos += 1;\n    flow.set(\"ul_count\", recebidos);\n}\nconst enviados = flow.get(\"dl_count\") || 0;\n\nconst r_ul = rssi(b[2]);\nconst r_dl = rssi(b[0]);\n\nmsg.payload = {\n    tipo: \"ul\",\n    t: Date.now(),\n    medida: flow.get(\"dl_medida\") || 0,\n    total:  flow.get(\"dl_total\")  || 0,\n    rssi_dl: r_dl, snr_dl: snr(b[1]),\n    rssi_ul: r_ul, snr_ul: snr(b[3]),\n    margem: Math.min(r_ul, r_dl) - SENSIBILIDADE_SF12,\n    estado, valido, recebidos, enviados,\n    psr: enviados ? Math.round(1000 * recebidos / enviados) / 10 : null\n};\nreturn msg;\n",
  "outputs": 1,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 390,
  "y": 160,
  "wires": [
